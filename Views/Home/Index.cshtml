        async function updateMachineEfficiency() {
            try {
                const today = new Date();
                const month = today.getMonth() + 1;
                const year = today.getFullYear();

                // ✓ STEP 1: Ambil list nama mesin DISTINCT dari DB
                const machineNamesRes = await fetch('/Home/GetMachineNamesFromDB');
                if (!machineNamesRes.ok) throw new Error(`Failed to fetch machine names: ${machineNamesRes.status}`);

                const machineNamesData = await machineNamesRes.json();
                const machineNamesFromDB = machineNamesData.data || [];

                console.log('[✓] Machine names dari DB:', machineNamesFromDB);

                // ✓ STEP 2: Ambil data efficiency dari DB
                const res = await fetch(`/Home/GetMachineEfficiencyFromDB?month=${month}&year=${year}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const responseJson = await res.json();
                const dbData = responseJson.data || responseJson;

                if (!Array.isArray(dbData)) {
                    console.error('Data bukan array:', dbData);
                    throw new Error('Invalid data format');
                }

                console.log('[✓] Efficiency data:', dbData);

                // ✓ STEP 3: Buat Map dari efficiency data
                const dbMap = new Map();
                dbData.forEach(d => dbMap.set(d.machineName.toLowerCase().trim(), d));

                const tableBody = document.querySelector('.machine-efficiency-table tbody');
                tableBody.innerHTML = '';

                // ✓ STEP 4: Render SEMUA machine names dari database
                machineNamesFromDB.forEach((machineName, index) => {
                    const data = dbMap.get(machineName.toLowerCase().trim());

                   const oee = data?.oEE != null ? parseFloat(data.oEE).toFixed(1) + '%' : '-';
const or = data?.operatingRatio != null ? parseFloat(data.operatingRatio).toFixed(1) + '%' : '-';
const abil = data?.ability != null ? parseFloat(data.ability).toFixed(1) + '%' : '-';
const qual = data?.quality != null ? parseFloat(data.quality).toFixed(1) + '%' : '-';

                    const row = document.createElement('tr');
                    row.id = `row-${index}`;
                    row.className = getRowClass(oee, or, abil, qual);
                    row.innerHTML = `
                        <td>${index + 1}</td>
                        <td><span class="status-dot"></span>${machineName}</td>
                        <td>${oee}</td>
                        <td>${or}</td>
                        <td>${abil}</td>
                        <td>${qual}</td>
                    `;
                    tableBody.appendChild(row);
                });

                console.log('[✓] Machine Efficiency Update Complete - ' + machineNamesFromDB.length + ' mesin');

            } catch (error) {
                console.error("[❌ Error in updateMachineEfficiency]", error);
                const tableBody = document.querySelector('.machine-efficiency-table tbody');
                tableBody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px;">Error loading data</td></tr>';
            }
        }

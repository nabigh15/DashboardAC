            createEnergyChart('cuEnergyChart', yesterdayCuEnergy, todayCuEnergy, { min: 10, max: 30, ticks: { stepSize: 10 } });

            const yesterdayCsEnergy = [15, 16, 14, 17, null, null, null, null, null, null];

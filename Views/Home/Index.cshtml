                let cuAlertReasons = [], cuTargetIds = [];
                const cuMiddayCondition = (now >= middayAlertTime && data.lineCU.totalActual < (data.lineCU.totalPlan / 2));
                const cuFinalCondition = (now >= finalAlertTime && (data.lineCU.dailyPlan - data.lineCU.totalActual) > 100);
                const cuWorkingTime = parseFloat(data.lossTimeCU.workingTime) || 0;
                const cuLoadTime = parseFloat(data.lossTimeCU.loadTime) || 0;
                const cuLoadTimeRatio = cuWorkingTime > 0 ? (cuLoadTime / cuWorkingTime) * 100 : 100;
                if (cuMiddayCondition || cuFinalCondition) {
                    cuAlertReasons.push(cuMiddayCondition ? 'Midday production achievement was below target.' : 'The end-of-day production deficit exceeded 100 units.');
                    cuTargetIds.push('assembly-achievement-card');
                }
                if (cuLoadTimeRatio < 80) {
                    cuAlertReasons.push(`Working time efficiency below 80% (<b>${cuLoadTimeRatio.toFixed(0)}%</b>).`);
                    cuTargetIds.push('assembly-loss-time-card');
                }
                if (cuAlertReasons.length > 0) {
                    outdoorMarker.classList.add('alert-balloon');
                    if (cuDetailsContainer) cuDetailsContainer.innerHTML = `<strong>Reason:</strong><br>${cuAlertReasons.join('<br>')}`;
                    alertDetails.set('outdoor-unit-marker', { type: 'assembly', targets: [...new Set(cuTargetIds)] });
                } else {
                    outdoorMarker.classList.remove('alert-balloon', 'expanded');
                    if (cuDetailsContainer) cuDetailsContainer.innerHTML = '';
                    alertDetails.delete('outdoor-unit-marker');
                }

            } catch (error) { console.error("Could not fetch data:", error); }
        }

        function toggleTheme() {
            const body = document.body;
            const btn = document.getElementById('theme-toggle');
            if (body.classList.contains('light-mode')) {
                body.classList.remove('light-mode');
                btn.textContent = '🌙 Dark';
                localStorage.setItem('theme', 'dark');
            } else {
                body.classList.add('light-mode');
                btn.textContent = '☀️ Light';
                localStorage.setItem('theme', 'light');
            }
            createOrUpdateChart('chartCU', null, lastDataCU.actual, lastDataCU.plan, lastDataCU.maxPlan);
            createOrUpdateChart('chartCS', null, lastDataCS.actual, lastDataCS.plan, lastDataCS.maxPlan);
        }

                document.addEventListener('DOMContentLoaded', () => {
                    setDate();
                    setInterval(setDate, 1000);
                    drawConnectorLines();
                    fetchData();
                    updateMachineEfficiency();
                    setInterval(() => {
                        fetchData();
                        updateMachineEfficiency();
                    }, 5000);

                    window.addEventListener('resize', drawConnectorLines);

                    const wrapperCU = document.getElementById('chartCU')?.closest('.chart-container');
                    const wrapperCS = document.getElementById('chartCS')?.closest('.chart-container');

                    const chartResizeObserver = new ResizeObserver(() => {
                        createOrUpdateChart('chartCU', null, lastDataCU.actual, lastDataCU.plan, lastDataCU.maxPlan);
                        createOrUpdateChart('chartCS', null, lastDataCS.actual, lastDataCS.plan, lastDataCS.maxPlan);
                    });

                    if (wrapperCU) chartResizeObserver.observe(wrapperCU);
                    if (wrapperCS) chartResizeObserver.observe(wrapperCS);

            const mapCard = document.querySelector('.map-card');
            if (mapCard) {
                new ResizeObserver(() => { drawConnectorLines(); }).observe(mapCard);
            }

            const leftColumn = document.querySelector('.left-column');
            leftColumn.addEventListener('click', (event) => {
                const balloon = event.target.closest('.info-balloon');
                if (balloon && balloon.classList.contains('alert-balloon')) {
                    const isAlreadyExpanded = balloon.classList.contains('expanded');
                    document.querySelectorAll('.info-balloon.expanded').forEach(b => {
                        if (b !== balloon) b.classList.remove('expanded');
                    });
                    balloon.classList.toggle('expanded');
                    if (!isAlreadyExpanded) {
                        const details = alertDetails.get(balloon.id);
                        if (details) {
                            if (details.type === 'machine') {
                                scrollToTarget(details.targetId);
                            } else if (details.type === 'assembly' && Array.isArray(details.targets)) {
                                details.targets.forEach(targetId => highlightTarget(targetId));
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>
</html>

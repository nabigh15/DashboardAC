    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script type="text/javascript">
        let chartCU, chartCS, lossChartCU, lossChartCS;
        let lastDataCU = { actual: 0, plan: 0 };
        let lastDataCS = { actual: 0, plan: 0 };
        const colorPalette = [
            'rgba(255, 99, 132, 0.7)',
            'rgba(54, 162, 235, 0.7)',
            'rgba(255, 206, 86, 0.7)',
            'rgba(75, 192, 192, 0.7)',
            'rgba(153, 102, 255, 0.7)',
            'rgba(255, 159, 64, 0.7)',
            'rgba(255, 99, 255, 0.7)',
            'rgba(99, 255, 132, 0.7)',
            'rgba(132, 99, 255, 0.7)',
            'rgba(235, 162, 54, 0.7)'
        ];

        const alertDetails = new Map();

        function scrollToTarget(elementId) {
            const targetElement = document.getElementById(elementId);
            const scrollContainer = document.querySelector('.machine-efficiency-table');
            if (targetElement && scrollContainer) {
                const targetPosition = targetElement.offsetTop;
                const containerHeight = scrollContainer.clientHeight;
                const targetHeight = targetElement.clientHeight;
                const scrollToPosition = targetPosition - (containerHeight / 2) + (targetHeight / 2);
                scrollContainer.scrollTo({ top: scrollToPosition, behavior: 'smooth' });
                targetElement.classList.add('highlight');
                setTimeout(() => targetElement.classList.remove('highlight'), 2500);
            }
        }

        function highlightTarget(elementId) {
            const targetElement = document.getElementById(elementId);
            if (targetElement) {
                targetElement.classList.add('highlight');
                setTimeout(() => targetElement.classList.remove('highlight'), 2500);
            }
        }

        function drawConnectorLines() {
            const container = document.querySelector('.map-card');
            const svg = document.getElementById('line-overlay');
            svg.innerHTML = svg.querySelector('defs').outerHTML;

            const machineCoordinates = {
                'outdoor-unit-marker': { x: 23, y: 37 },
                'indoor-unit-marker': { x: 11, y: 53 },
                'machine-300t-new': { x: 87, y: 73 },
                'machine-300t': { x: 86, y: 52 },
                'machine-200t': { x: 84, y: 44 },
                'machine-400t': { x: 88, y: 64 },
                'machine-110t-amada': { x: 80, y: 32 },
                'machine-110t-komatsu': { x: 88, y: 32 },
                'machine-sf-250': { x: 68, y: 20 },
                'machine-fix-80': { x: 62, y: 20 },
                'machine-fix-12': { x: 57, y: 20 },
                'machine-fix-36': { x: 50, y: 20 },
                'machine-kyoshin-ori': { x: 51, y: 36 },
                'machine-kyoshin': { x: 63, y: 36 },
                'machine-li-chin': { x: 57, y: 36 },
                'machine-14-row': { x: 83, y: 19 },
                'machine-7-row': { x: 86, y: 22 },
                'oven': { x: 69, y: 47 },
                'evap': { x: 63, y: 65 },
                'cond': { x: 73, y: 65 }
            };

            const img = container.querySelector('img');
            const containerWidth = img ? img.offsetWidth : container.offsetWidth;
            const containerHeight = img ? img.offsetHeight : container.offsetHeight;

            const balloons = container.querySelectorAll('.info-balloon');
            balloons.forEach(balloon => {
                const id = balloon.id;
                const coords = machineCoordinates[id];
                if (coords) {
                    balloon.style.left = `${coords.x}%`;
                    balloon.style.top = `${coords.y}%`;
                }
            });

            for (const balloonId in machineCoordinates) {
                const balloon = document.getElementById(balloonId);
                if (balloon) {
                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    const startX = balloon.offsetLeft + balloon.offsetWidth / 2;
                    const startY = balloon.classList.contains('tacked-from-top')
                        ? balloon.offsetTop
                        : balloon.offsetTop + balloon.offsetHeight;
                    const endX = (machineCoordinates[balloonId].x / 100) * containerWidth;
                    const endY = (machineCoordinates[balloonId].y / 100) * containerHeight;
                    line.setAttribute('x1', startX);
                    line.setAttribute('y1', startY);
                    line.setAttribute('x2', endX);
                    line.setAttribute('y2', endY);
                    line.setAttribute('class', 'connector-line');
                    svg.appendChild(line);
                }
            }
        }

        function drawSolidArc(ctx, centerX, centerY, radius, percentage, color, lineWidth) {
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const totalAngle = endAngle - startAngle;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, startAngle, endAngle, false);
            ctx.strokeStyle = 'rgba(150, 150, 150, 0.3)';
            ctx.lineWidth = lineWidth;
            ctx.stroke();
            if (percentage > 0) {
                const progressAngle = startAngle + (totalAngle * Math.min(percentage, 100) / 100);
                ctx.beginPath();
                ctx.arc(centerX, centerY, radius, startAngle, progressAngle, false);
                ctx.strokeStyle = color;
                ctx.lineWidth = lineWidth;
                ctx.stroke();
            }
        }

        function getSpeedColor(percentage) {
            if (percentage >= 85) return '#28a745';
            else if (percentage >= 80) return '#ffc107';
            else return '#d90429';
        }

        function createOrUpdateChart(canvasId, chartInstance, actual, dailyPlan) {
            const maxDaily = (canvasId === 'chartCU') ? 2370 : 2115;
            const percentage = dailyPlan > 0 ? (actual / dailyPlan) * 100 : 0;
            const cappedNeedlePercentage = Math.min(percentage, 120);
            const actualBarPercentage = (actual / maxDaily) * 100;
            const planBarPercentage = (dailyPlan / maxDaily) * 100;
            const cappedActualBar = Math.min(actualBarPercentage, 120);
            const cappedPlanBar = Math.min(planBarPercentage, 120);

            if (chartInstance) { chartInstance.destroy(); }

            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            const wrapper = canvas.closest('.chart-container');
            const w = wrapper ? wrapper.offsetWidth : 280;
            const h = wrapper ? wrapper.offsetHeight : 200;

            // Melebar ke samping: pakai lebar penuh container
        canvas.width = 260;
        canvas.height = 190;

        const scale = 1;
        const centerX = canvas.width / 2;
        const centerY = canvas.height - 90;
        const radiusOuter = 72;
        const radiusMiddle = 57;
        const radiusInner = 42;
        const lineWidth = 8;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            let backlightColor;
            let backlightIntensity;
            if (percentage < 80) {
                backlightColor = 'rgba(217, 4, 41, ';
                backlightIntensity = 0.5;
            } else if (percentage < 85) {
                backlightColor = 'rgba(255, 193, 7, ';
                backlightIntensity = 0.4;
            } else {
                backlightColor = 'rgba(40, 167, 69, ';
                backlightIntensity = 0.35;
            }

            const backlightRadius = radiusOuter - 60;
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const gradient = ctx.createRadialGradient(centerX, centerY, backlightRadius - 10, centerX, centerY, backlightRadius + 10);
            gradient.addColorStop(0, backlightColor + '0)');
            gradient.addColorStop(0.5, backlightColor + backlightIntensity + ')');
            gradient.addColorStop(1, backlightColor + '0)');
            ctx.beginPath();
            ctx.arc(centerX, centerY, backlightRadius, startAngle, endAngle, false);
            ctx.strokeStyle = gradient;
            ctx.lineWidth = 20;
            ctx.stroke();

        drawSolidArc(ctx, centerX, centerY, radiusOuter, 100, '#F59E0B', lineWidth * 1.5);
        drawSolidArc(ctx, centerX, centerY, radiusMiddle, cappedActualBar, '#22C55E', lineWidth * 1.5);
        drawSolidArc(ctx, centerX, centerY, radiusInner, cappedPlanBar, '#A855F7', lineWidth * 1.5);

            drawTickMarks(ctx, centerX, centerY, radiusOuter, scale);
            drawNumbers(ctx, centerX, centerY, radiusOuter, scale);
            drawNeedle(ctx, centerX, centerY, radiusOuter * 0.30, cappedNeedlePercentage, scale);

            // Titik tengah besar
            ctx.beginPath();
            ctx.arc(centerX, centerY, 10 * scale, 0, 2 * Math.PI);
            ctx.fillStyle = '#fff';
            ctx.fill();
            ctx.strokeStyle = '#363B5E';
            ctx.lineWidth = 3;
            ctx.stroke();
            ctx.beginPath();
            ctx.arc(centerX, centerY, 4 * scale, 0, 2 * Math.PI);
            ctx.fillStyle = '#363B5E';
            ctx.fill();

            const lineId = canvasId === 'chartCU' ? 'cu' : 'cs';
            document.getElementById(`legend-actual-${lineId}`).textContent = actual;
            document.getElementById(`legend-plan-${lineId}`).textContent = dailyPlan;
            const achievementPct = dailyPlan > 0 ? ((actual / dailyPlan) * 100).toFixed(0) : 0;
            document.getElementById(`legend-achievement-${lineId}`).textContent = achievementPct;

            const speedDot = document.getElementById(`speed-dot-${lineId}`);
            if (speedDot) {
                const pct = parseFloat(achievementPct);
                if (pct >= 85) speedDot.style.borderColor = '#22C55E';
                else if (pct >= 80) speedDot.style.borderColor = '#F59E0B';
                else speedDot.style.borderColor = '#d90429';
            }

            document.getElementById(`total-plan-display-${lineId}`).textContent = maxDaily.toLocaleString('id-ID');
            document.getElementById(`chart-end-text-${lineId}`).textContent = "";

            return null;
        }

        function drawTickMarks(ctx, centerX, centerY, radius, scale = 1) {
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const totalTicks = 11;
            for (let i = 0; i < totalTicks; i++) {
                const angle = startAngle + (endAngle - startAngle) * (i / (totalTicks - 1));
                const isMainTick = i % 2 === 0;
                const innerRadius = radius - (43 * scale);
                const outerRadius = radius - (isMainTick ? 39 * scale : 41 * scale);
                const x1 = centerX + innerRadius * Math.cos(angle);
                const y1 = centerY + innerRadius * Math.sin(angle);
                const x2 = centerX + outerRadius * Math.cos(angle);
                const y2 = centerY + outerRadius * Math.sin(angle);
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = isMainTick ? 2 : 1.5;
                ctx.stroke();
            }
        }

        function drawNumbers(ctx, centerX, centerY, radius, scale = 1) {
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const numbers = [0, 20, 40, 60, 80, 100, 120];
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            for (let i = 0; i < numbers.length; i++) {
                const angle = startAngle + (endAngle - startAngle) * (numbers[i] / 120);
                const textRadius = radius - (52 * scale);
                let x = centerX + textRadius * Math.cos(angle);
                let y = centerY + textRadius * Math.sin(angle);
                const glowGradient = ctx.createRadialGradient(x, y, 0, x, y, 15);
                glowGradient.addColorStop(0, 'rgba(100, 150, 255, 0.4)');
                glowGradient.addColorStop(0.5, 'rgba(100, 150, 255, 0.2)');
                glowGradient.addColorStop(1, 'rgba(100, 150, 255, 0)');
                ctx.fillStyle = glowGradient;
                ctx.fillRect(x - 15, y - 15, 30, 30);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
                ctx.font = `bold ${9 * scale}px Arial`;
                ctx.fillText(numbers[i], x, y);
            }
        }

        function drawNeedle(ctx, centerX, centerY, length, percentage, scale = 1) {
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const cappedPercentage = Math.min(percentage, 120);
            const angle = startAngle + (endAngle - startAngle) * (cappedPercentage / 120);
            const needleX = centerX + length * Math.cos(angle);
            const needleY = centerY + length * Math.sin(angle);
            // Shadow
            ctx.beginPath();
            ctx.moveTo(centerX + 2, centerY + 2);
            ctx.lineTo(needleX + 2, needleY + 2);
            ctx.strokeStyle = 'rgba(0, 0, 0, 0.4)';
            ctx.lineWidth = 6;
            ctx.stroke();
            // Needle putih
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.lineTo(needleX, needleY);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.95)';
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.stroke();
        }

        function renderDefectBar(containerId, defectsByCategory) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const sorted = [...defectsByCategory].sort((a, b) => b.count - a.count);
            const maxVal = Math.max(...sorted.map(d => d.count), 1);
            container.innerHTML = '';
            sorted.forEach(d => {
                const pct = (d.count / maxVal) * 100;
                const row = document.createElement('div');
                row.className = 'defect-bar-row';
                row.innerHTML = `
                    <div class="defect-bar-label">${d.category}</div>
                    <div class="defect-bar-track">
                        <div class="defect-bar-fill" style="width:${pct}%"></div>
                    </div>
                    <span class="defect-bar-value" style="position:static; transform:none; font-size:0.85rem; min-width:35px; text-align:right;">${pct.toFixed(0)}%</span>
                `;
                container.appendChild(row);
            });
        }

        function setDate() {
            const dateElement = document.getElementById('current-date');
            const now = new Date();
            const weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            const formattedDate = `${weekdays[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            dateElement.textContent = formattedDate;
        }

        function drawLossTimeMarkers(trackId, hourlyEvents, totalMinutesInTimeline) {
            const trackElement = document.getElementById(trackId);
            if (!trackElement || !hourlyEvents) return;
            trackElement.querySelectorAll('.loss-marker').forEach(marker => marker.remove());
            if (totalMinutesInTimeline <= 0) return;
            for (const hour in hourlyEvents) {
                if (hourlyEvents.hasOwnProperty(hour)) {
                    hourlyEvents[hour].forEach(event => {
                        const startOffsetMinutes = ((parseInt(hour) - 7) * 60) + event.startMinute;
                        const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;
                        const widthPercent = (event.durationMinutes / totalMinutesInTimeline) * 100;
                        if (leftPercent + widthPercent <= 100) {
                            const marker = document.createElement('div');
                            marker.className = 'loss-marker';
                            marker.style.left = `${leftPercent}%`;
                            marker.style.width = `${widthPercent}%`;
                            trackElement.appendChild(marker);
                        }
                    });
                }
            }
        }

        function drawBreakTimeMarkers(trackId, breakTimes, totalMinutesInTimeline) {
            const trackElement = document.getElementById(trackId);
            if (!trackElement || !breakTimes) return;
            trackElement.querySelectorAll('.break-marker').forEach(marker => marker.remove());
            if (totalMinutesInTimeline <= 0) return;
            const timelineStartHour = 7;
            breakTimes.forEach(breakTime => {
                const startParts = breakTime.start.split(':').map(Number);
                const endParts = breakTime.end.split(':').map(Number);
                const startTotalMinutes = startParts[0] * 60 + startParts[1];
                const endTotalMinutes = endParts[0] * 60 + endParts[1];
                const startOffsetMinutes = startTotalMinutes - (timelineStartHour * 60);
                const durationMinutes = endTotalMinutes - startTotalMinutes;
                if (durationMinutes <= 0) return;
                const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;
                const widthPercent = (durationMinutes / totalMinutesInTimeline) * 100;
                if (leftPercent + widthPercent <= 100) {
                    const marker = document.createElement('div');
                    marker.className = 'break-marker';
                    marker.style.left = `${leftPercent}%`;
                    marker.style.width = `${widthPercent}%`;
                    trackElement.appendChild(marker);
                }
            });
        }

        function updateAssemblyTimeline(lineId, lossData) {
            const trackElement = document.getElementById(`timeline-track-${lineId}`);
            const progressElement = document.getElementById(`timeline-progress-${lineId}`);
            const minutesContainer = document.getElementById(`timeline-minutes-${lineId}`);
            const hoursElement = document.querySelector(`#timeline-track-${lineId}`).closest('.timeline-container').querySelector('.timeline-hours');
            if (!trackElement || !hoursElement || !progressElement || !minutesContainer) return;
            const now = new Date();
            const startHour = 7;
            const endOfDayHour = 16;
            let displayEndHour = now.getHours() + 1;
            displayEndHour = Math.max(startHour + 1, displayEndHour);
            displayEndHour = Math.min(displayEndHour, endOfDayHour);
            const totalMinutesInTimeline = (displayEndHour - startHour) * 60;
            hoursElement.innerHTML = '';
            for (let h = startHour; h < displayEndHour; h++) {
                const hourSpan = document.createElement('span');
                hourSpan.textContent = `${String(h).padStart(2, '0')}.00`;
                hoursElement.appendChild(hourSpan);
            }
            minutesContainer.innerHTML = '';
            drawBreakTimeMarkers(`timeline-track-${lineId}`, lossData.breakTimes, totalMinutesInTimeline);
            drawLossTimeMarkers(`timeline-track-${lineId}`, lossData.hourlyEvents, totalMinutesInTimeline);
            const timelineStart = new Date(now);
            timelineStart.setHours(startHour, 0, 0, 0);
            let elapsedMillis = now - timelineStart;
            const totalDurationMillis = totalMinutesInTimeline * 60 * 1000;
            elapsedMillis = Math.max(0, Math.min(elapsedMillis, totalDurationMillis));
            const progressPercent = (totalDurationMillis > 0) ? (elapsedMillis / totalDurationMillis) * 100 : 0;
            progressElement.style.width = `${progressPercent}%`;
        }

        function getRowClass(oee, oratio, ability, quality) {
            const minVal = Math.min(parseFloat(oee), oratio, ability, quality);
            if (minVal < 80) return 'row-red';
            if (minVal < 85) return 'row-yellow';
            return 'row-green';
        }

        async function updateMachineEfficiency() {
            const apiUrl = '/Home/GetMachineEfficiencyData';
            const machineMapping = {
                'thtn': '300TN', 'twt': '200T', 'thto': '400T', 'ota': '110T Amada',
                'otb': '110T Komatsu', 'sftf': 'SF 250', 'fez': 'FIX 80', 'fts': 'FIX 36',
                'eky': 'Kyoshin 6.35', 'elc': 'Li-chin', 'hpn': '14 Row', 'hpo': '7 Row'
            };
            const balloonMapping = {
                'thtn': 'machine-300t-new', 'twt': 'machine-200t', 'thto': 'machine-400t', 'ota': 'machine-110t-amada',
                'otb': 'machine-110t-komatsu', 'sftf': 'machine-sf-250', 'fez': 'machine-fix-80', 'fts': 'machine-fix-36',
                'eky': 'machine-kyoshin', 'elc': 'machine-li-chin', 'hpn': 'machine-14-row', 'hpo': 'machine-7-row'
            };
            try {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                const apiData = await response.json();
                const dataMap = new Map(apiData.map(item => [item.tagName, item.value]));
                const tableBody = document.querySelector('.machine-efficiency-table tbody');
                tableBody.innerHTML = '';
                let index = 1;
                for (const [prefix, machineName] of Object.entries(machineMapping)) {
                    const oeeValue = dataMap.get(`${prefix}Oee`) || 0;
                    const operatingRatioValue = dataMap.get(`${prefix}Efficiency`) || 0;
                    const abilityValue = dataMap.get(`${prefix}Quantity`) || 0;
                    const qualityValue = dataMap.get(`${prefix}Quality`) || 0;
                    const oee = (oeeValue / 10).toFixed(0);
                    const operatingRatioPercent = operatingRatioValue * 0.1;
                    const abilityPercent = abilityValue * 0.1;
                    const qualityPercent = qualityValue * 0.1;
                    const balloonId = balloonMapping[prefix];
                    const balloonElement = document.getElementById(balloonId);
                    const isAlert = oee < 80 || operatingRatioPercent < 80 || abilityPercent < 80 || qualityPercent < 80;
                    if (balloonElement) {
                        const detailsContainer = balloonElement.querySelector('.balloon-details');
                        if (isAlert) {
                            balloonElement.classList.add('alert-balloon');
                            let reasons = [];
                            if (oee < 80) reasons.push(`OEE: <b>${oee}%</b>`);
                            if (operatingRatioPercent < 80) reasons.push(`OR: <b>${operatingRatioPercent.toFixed(0)}%</b>`);
                            if (abilityPercent < 80) reasons.push(`Ability: <b>${abilityPercent.toFixed(0)}%</b>`);
                            if (qualityPercent < 80) reasons.push(`Quality: <b>${qualityPercent.toFixed(0)}%</b>`);
                            if (detailsContainer) detailsContainer.innerHTML = `${reasons.join('<br>')}`;
                            alertDetails.set(balloonId, { type: 'machine', targetId: `row-${prefix}` });
                        } else {
                            balloonElement.classList.remove('alert-balloon');
                            balloonElement.classList.remove('expanded');
                            if (detailsContainer) detailsContainer.innerHTML = '';
                            alertDetails.delete(balloonId);
                        }
                    }
                    const row = document.createElement('tr');
                    row.id = `row-${prefix}`;
                    row.className = getRowClass(oee, operatingRatioPercent, abilityPercent, qualityPercent);
                    row.innerHTML = `
                        <td>${index}</td>
                        <td><span class="status-dot"></span>${machineName}</td>
                        <td>${oee}</td>
                        <td>${operatingRatioPercent.toFixed(0)}</td>
                        <td>${abilityPercent.toFixed(0)}</td>
                        <td>${qualityPercent.toFixed(0)}</td>
                    `;
                    tableBody.appendChild(row);
                    index++;
                }
            } catch (error) {
                console.error("Could not fetch machine efficiency data:", error);
                const tableBody = document.querySelector('.machine-efficiency-table tbody');
                const machines = ['300TN', '200T', '400T', '110T Amada', '110T Komatsu', 'SF 250', 'FIX 80', 'FIX 36', 'Kyoshin 6.35', 'Li-chin', '14 Row', '7 Row'];
                tableBody.innerHTML = machines.map((name, i) => `
                    <tr>
                        <td>${i + 1}</td>
                        <td>${name}</td>
                        <td>-</td><td>-</td><td>-</td><td>-</td>
                    </tr>
                `).join('');
            }
        }

        async function fetchData() {
            try {
                const response = await fetch('/Home/GetDashboardData');
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                const data = await response.json();

                const displayPlanCU = Math.min(data.lineCU.totalPlan, data.lineCU.dailyPlan);
                chartCU = createOrUpdateChart('chartCU', chartCU, data.lineCU.totalActual, displayPlanCU);
                lastDataCU = { actual: data.lineCU.totalActual, plan: displayPlanCU };

                const displayPlanCS = Math.min(data.lineCS.totalPlan, data.lineCS.dailyPlan);
                chartCS = createOrUpdateChart('chartCS', chartCS, data.lineCS.totalActual, displayPlanCS);
                lastDataCS = { actual: data.lineCS.totalActual, plan: displayPlanCS };

                const cuDefectsByCategory = data.lineCU.defectsByCategory || [
                    {category: 'Preparing', count: 5}, {category: 'Gas Leak', count: 3},
                    {category: 'Running', count: 8}, {category: 'Inner', count: 2},
                    {category: 'Final', count: 4}, {category: 'Detail', count: 1}
                ];
                renderDefectBar('defect-bar-cu', cuDefectsByCategory);
                const totalDefectsCU = cuDefectsByCategory.reduce((sum, d) => sum + d.count, 0);
                const qualityRateCU = data.lineCU.totalActual > 0 ? ((data.lineCU.totalActual - totalDefectsCU) / data.lineCU.totalActual * 100) : 100;
                document.getElementById('quality-percent-cu').textContent = qualityRateCU.toFixed(0);
                document.getElementById('defect-count-cu').textContent = totalDefectsCU;

                const csDefectsByCategory = data.lineCS.defectsByCategory || [
                    {category: 'Chassis', count: 4}, {category: 'Preparing', count: 6},
                    {category: 'Running', count: 7}, {category: 'Final', count: 3}
                ];
                renderDefectBar('defect-bar-cs', csDefectsByCategory);
                const totalDefectsCS = csDefectsByCategory.reduce((sum, d) => sum + d.count, 0);
                const qualityRateCS = data.lineCS.totalActual > 0 ? ((data.lineCS.totalActual - totalDefectsCS) / data.lineCS.totalActual * 100) : 100;
                document.getElementById('quality-percent-cs').textContent = qualityRateCS.toFixed(0);
                document.getElementById('defect-count-cs').textContent = totalDefectsCS;

                const lossTimeCU = data.lossTimeCU || {};
                const lossTimeCS = data.lossTimeCS || {};

                document.getElementById('cu-working-time').textContent = lossTimeCU.workingTime ?? 0;
                document.getElementById('cu-loss-time').textContent = lossTimeCU.lossTime ?? 0;
                document.getElementById('cu-load-time').textContent = lossTimeCU.loadTime ?? 0;
                if (lossTimeCU && Object.keys(lossTimeCU).length > 0) updateAssemblyTimeline('cu', lossTimeCU);

                document.getElementById('cs-working-time').textContent = lossTimeCS.workingTime ?? 0;
                document.getElementById('cs-loss-time').textContent = lossTimeCS.lossTime ?? 0;
                document.getElementById('cs-load-time').textContent = lossTimeCS.loadTime ?? 0;
                if (lossTimeCS && Object.keys(lossTimeCS).length > 0) updateAssemblyTimeline('cs', lossTimeCS);

                const now = new Date();
                const indoorMarker = document.getElementById('indoor-unit-marker');
                const outdoorMarker = document.getElementById('outdoor-unit-marker');
                const middayAlertTime = new Date(now); middayAlertTime.setHours(12, 0, 0, 0);
                const finalAlertTime = new Date(now); finalAlertTime.setHours(15, 40, 0, 0);

                // CS alerts
                const csDetailsContainer = indoorMarker.querySelector('.balloon-details');
                let csAlertReasons = [], csTargetIds = [];
                const csMiddayCondition = (now >= middayAlertTime && data.lineCS.totalActual < (data.lineCS.totalPlan / 2));
                const csFinalCondition = (now >= finalAlertTime && (data.lineCS.dailyPlan - data.lineCS.totalActual) > 100);
                const csWorkingTime = parseFloat(data.lossTimeCS.workingTime) || 0;
                const csLoadTime = parseFloat(data.lossTimeCS.loadTime) || 0;
                const csLoadTimeRatio = csWorkingTime > 0 ? (csLoadTime / csWorkingTime) * 100 : 100;
                if (csMiddayCondition || csFinalCondition) {
                    csAlertReasons.push(csMiddayCondition ? 'Midday production achievement was below target.' : 'The end-of-day production deficit exceeded 100 units.');
                    csTargetIds.push('assembly-achievement-card');
                }
                if (csLoadTimeRatio < 80) {
                    csAlertReasons.push(`Working time efficiency below 80% (<b>${csLoadTimeRatio.toFixed(0)}%</b>).`);
                    csTargetIds.push('assembly-loss-time-card');
                }
                if (csAlertReasons.length > 0) {
                    indoorMarker.classList.add('alert-balloon');
                    if (csDetailsContainer) csDetailsContainer.innerHTML = `<strong>Penyebab:</strong><br>${csAlertReasons.join('<br>')}`;
                    alertDetails.set('indoor-unit-marker', { type: 'assembly', targets: [...new Set(csTargetIds)] });
                } else {
                    indoorMarker.classList.remove('alert-balloon', 'expanded');
                    if (csDetailsContainer) csDetailsContainer.innerHTML = '';
                    alertDetails.delete('indoor-unit-marker');
                }

                // CU alerts
                const cuDetailsContainer = outdoorMarker.querySelector('.balloon-details');
                let cuAlertReasons = [], cuTargetIds = [];
                const cuMiddayCondition = (now >= middayAlertTime && data.lineCU.totalActual < (data.lineCU.totalPlan / 2));
                const cuFinalCondition = (now >= finalAlertTime && (data.lineCU.dailyPlan - data.lineCU.totalActual) > 100);
                const cuWorkingTime = parseFloat(data.lossTimeCU.workingTime) || 0;
                const cuLoadTime = parseFloat(data.lossTimeCU.loadTime) || 0;
                const cuLoadTimeRatio = cuWorkingTime > 0 ? (cuLoadTime / cuWorkingTime) * 100 : 100;
                if (cuMiddayCondition || cuFinalCondition) {
                    cuAlertReasons.push(cuMiddayCondition ? 'Midday production achievement was below target.' : 'The end-of-day production deficit exceeded 100 units.');
                    cuTargetIds.push('assembly-achievement-card');
                }
                if (cuLoadTimeRatio < 80) {
                    cuAlertReasons.push(`Working time efficiency below 80% (<b>${cuLoadTimeRatio.toFixed(0)}%</b>).`);
                    cuTargetIds.push('assembly-loss-time-card');
                }
                if (cuAlertReasons.length > 0) {
                    outdoorMarker.classList.add('alert-balloon');
                    if (cuDetailsContainer) cuDetailsContainer.innerHTML = `<strong>Reason:</strong><br>${cuAlertReasons.join('<br>')}`;
                    alertDetails.set('outdoor-unit-marker', { type: 'assembly', targets: [...new Set(cuTargetIds)] });
                } else {
                    outdoorMarker.classList.remove('alert-balloon', 'expanded');
                    if (cuDetailsContainer) cuDetailsContainer.innerHTML = '';
                    alertDetails.delete('outdoor-unit-marker');
                }

            } catch (error) { console.error("Could not fetch data:", error); }
        }

        document.addEventListener('DOMContentLoaded', () => {
            setDate();
            setInterval(setDate, 1000);
            drawConnectorLines();
            fetchData();
            updateMachineEfficiency();
            setInterval(() => {
                fetchData();
                updateMachineEfficiency();
            }, 5000);

            window.addEventListener('resize', drawConnectorLines);

            const achievementCard = document.getElementById('assembly-achievement-card');
            if (achievementCard) {
                new ResizeObserver(() => {
                    createOrUpdateChart('chartCU', null, lastDataCU.actual, lastDataCU.plan);
                    createOrUpdateChart('chartCS', null, lastDataCS.actual, lastDataCS.plan);
                }).observe(achievementCard);
            }

            const mapCard = document.querySelector('.map-card');
            if (mapCard) {
                new ResizeObserver(() => { drawConnectorLines(); }).observe(mapCard);
            }

            const leftColumn = document.querySelector('.left-column');
            leftColumn.addEventListener('click', (event) => {
                const balloon = event.target.closest('.info-balloon');
                if (balloon && balloon.classList.contains('alert-balloon')) {
                    const isAlreadyExpanded = balloon.classList.contains('expanded');
                    document.querySelectorAll('.info-balloon.expanded').forEach(b => {
                        if (b !== balloon) b.classList.remove('expanded');
                    });
                    balloon.classList.toggle('expanded');
                    if (!isAlreadyExpanded) {
                        const details = alertDetails.get(balloon.id);
                        if (details) {
                            if (details.type === 'machine') {
                                scrollToTarget(details.targetId);
                            } else if (details.type === 'assembly' && Array.isArray(details.targets)) {
                                details.targets.forEach(targetId => highlightTarget(targetId));
                            }
                        }
                    }
                }
            });
        });
    </script>
</body>

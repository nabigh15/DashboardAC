@{
    ViewData["Title"] = "Production Management System";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="main-container">
        <header class="main-header">
            <img src="~/assets/panasonic_logo.png" alt="Panasonic" class="logo" />
            <div class="title">Production Management System</div>
            <div id="current-date" class="date"></div>
        </header>
        <main class="main-content">

            <div class="left-column">

                <!-- CARD 1: Denah Pabrik -->
                <div class="map-card widget-card" style="padding: 0; overflow: hidden; position: relative;">
                    <img src="~/assets/denah_pabrik.png" alt="Factory Floor Plan" />

                    <!-- Label Air Conditioner -->
                    <div style="position:absolute;top:16px;left:20px;z-index:10;
                        font-family:'DIN Pro',Verdana,sans-serif;
                        font-size:0.95rem;font-weight:600;color:#fff;
                        text-shadow:0 1px 4px rgba(0,0,0,0.8);">
                        Air Conditioner
                    </div>

                    <!-- Legend pojok kanan bawah -->
                    <div class="legend-container main-legend">
                        <div class="legend-item">
                            <span style="width:12px;height:12px;border-radius:2px;background:#d90429;display:inline-block;"></span>
                            <span class="legend-label">&lt; 80%</span>
                        </div>
                        <div class="legend-item">
                            <span style="width:12px;height:12px;border-radius:2px;background:#ffc107;display:inline-block;"></span>
                            <span class="legend-label">&lt; 85%</span>
                        </div>
                        <div class="legend-item">
                            <span style="width:12px;height:12px;border-radius:2px;background:#28a745;display:inline-block;"></span>
                            <span class="legend-label">≥ 85%</span>
                        </div>
                    </div>


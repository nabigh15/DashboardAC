    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script type="text/javascript">
        let chartCU, chartCS, lossChartCU, lossChartCS;
        let lastDataCU = { actual: 0, plan: 0 };
        let lastDataCS = { actual: 0, plan: 0 };
        const colorPalette = [
            'rgba(255, 99, 132, 0.7)',
            'rgba(54, 162, 235, 0.7)',
            'rgba(255, 206, 86, 0.7)',
            'rgba(75, 192, 192, 0.7)',
            'rgba(153, 102, 255, 0.7)',
            'rgba(255, 159, 64, 0.7)',
            'rgba(255, 99, 255, 0.7)',
            'rgba(99, 255, 132, 0.7)',
            'rgba(132, 99, 255, 0.7)',
            'rgba(235, 162, 54, 0.7)'
        ];

        const alertDetails = new Map();

        function scrollToTarget(elementId) {
            const targetElement = document.getElementById(elementId);
            const scrollContainer = document.querySelector('.machine-efficiency-table');
            if (targetElement && scrollContainer) {
                const targetPosition = targetElement.offsetTop;
                const containerHeight = scrollContainer.clientHeight;
                const targetHeight = targetElement.clientHeight;
                const scrollToPosition = targetPosition - (containerHeight / 2) + (targetHeight / 2);
                scrollContainer.scrollTo({ top: scrollToPosition, behavior: 'smooth' });
                targetElement.classList.add('highlight');
                setTimeout(() => targetElement.classList.remove('highlight'), 2500);
            }
        }

        function highlightTarget(elementId) {
            const targetElement = document.getElementById(elementId);
            if (targetElement) {
                targetElement.classList.add('highlight');
                setTimeout(() => targetElement.classList.remove('highlight'), 2500);
            }
        }

        function drawConnectorLines() {
            const container = document.querySelector('.map-card');
            const svg = document.getElementById('line-overlay');
            svg.innerHTML = svg.querySelector('defs').outerHTML;

            const machineCoordinates = {
                'outdoor-unit-marker': { x: 23, y: 37 },
                'indoor-unit-marker': { x: 11, y: 53 },
                'machine-300t-new': { x: 90, y: 71 },
                'machine-300t': { x: 90, y: 51 },
                'machine-200t': { x: 90, y: 43 },
                'machine-400t': { x: 90, y: 62 },
                'machine-110t-amada': { x: 72, y: 28 },
                'machine-110t-komatsu': { x: 88, y: 36 },
                'machine-sf-250': { x: 69, y: 12 },
                'machine-fix-80': { x: 61, y: 12 },
                'machine-fix-12': { x: 53, y: 12 },
                'machine-fix-36': { x: 45, y: 12 },
                'machine-kyoshin-ori': { x: 46, y: 30 },
                'machine-kyoshin': { x: 62, y: 30 },
                'machine-li-chin': { x: 54, y: 30 },
                'machine-14-row': { x: 83, y: 14 },
                'machine-7-row': { x: 86, y: 26 },
                'oven': { x: 60, y: 45 },
                'evap': { x: 54, y: 65 },
                'cond': { x: 76, y: 70 }
            };

            const arrowTargets = {
                'outdoor-unit-marker':   { x: 23, y: 37 },
                'indoor-unit-marker':    { x: 11, y: 53 },
                'machine-300t-new':      { x: 88, y: 73 },
                'machine-300t':          { x: 86, y: 53 },
                'machine-200t':          { x: 85, y: 45 },
                'machine-400t':          { x: 88, y: 64 },
                'machine-110t-amada':    { x: 79, y: 33 },
                'machine-110t-komatsu':  { x: 88, y: 36 },
                'machine-sf-250':        { x: 69, y: 20 },
                'machine-fix-80':        { x: 63, y: 20 },
                'machine-fix-12':        { x: 57, y: 20 },
                'machine-fix-36':        { x: 52, y: 20 },
                'machine-kyoshin-ori':   { x: 52, y: 36 },
                'machine-kyoshin':       { x: 63, y: 36 },
                'machine-li-chin':       { x: 58, y: 36 },
                'machine-14-row':        { x: 83, y: 20 },
                'machine-7-row':         { x: 86, y: 26 },
                'oven':                  { x: 70, y: 47 },
                'evap':                  { x: 63, y: 67 },
                'cond':                  { x: 75, y: 72 }
            };

            const img = container.querySelector('img');
            const containerWidth = img ? img.offsetWidth : container.offsetWidth;
            const containerHeight = img ? img.offsetHeight : container.offsetHeight;

            const balloons = container.querySelectorAll('.info-balloon');
            balloons.forEach(balloon => {
                const id = balloon.id;
                const coords = machineCoordinates[id];
                if (coords) {
                    balloon.style.left = `${coords.x}%`;
                    balloon.style.top = `${coords.y}%`;
                }
            });

            for (const balloonId in machineCoordinates) {
                const balloon = document.getElementById(balloonId);
                if (balloon) {
                    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
                    const containerRect = container.getBoundingClientRect();
                    const balloonRect = balloon.getBoundingClientRect();
                    const startX = balloonRect.left - containerRect.left + balloonRect.width / 2;
                    const startY = balloonRect.top - containerRect.top + balloonRect.height / 2;
                    const target = arrowTargets[balloonId] || machineCoordinates[balloonId];
                    const endX = (target.x / 100) * containerWidth;
                    const endY = (target.y / 100) * containerHeight;
                    line.setAttribute('x1', startX);
                    line.setAttribute('y1', startY);
                    line.setAttribute('x2', endX);
                    line.setAttribute('y2', endY);
                    line.setAttribute('class', 'connector-line');
                    svg.appendChild(line);
                }
            }
        }

        function drawSolidArc(ctx, centerX, centerY, radius, percentage, color, lineWidth) {
            const startAngle = Math.PI * 0.75;
            const endAngle = Math.PI * 2.25;
            const totalAngle = endAngle - startAngle;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, startAngle, endAngle, false);
            ctx.strokeStyle = 'rgba(150, 150, 150, 0.3)';
            ctx.lineWidth = lineWidth;
            ctx.stroke();
            if (percentage > 0) {
                const progressAngle = startAngle + (totalAngle * Math.min(percentage, 100) / 100);
                ctx.beginPath();
                ctx.arc(centerX, centerY, radius, startAngle, progressAngle, false);
                ctx.strokeStyle = color;
                ctx.lineWidth = lineWidth;
                ctx.stroke();
            }
        }

        function getSpeedColor(percentage) {
            if (percentage >= 85) return '#28a745';
            else if (percentage >= 80) return '#ffc107';
            else return '#d90429';
        }

                function createOrUpdateChart(canvasId, chartInstance, actual, displayPlan, maxPlan) {
                    const isLightMode = document.body.classList.contains('light-mode');
                    const ref = maxPlan > 0 ? maxPlan : displayPlan;
                    const pct = displayPlan > 0 ? (actual / displayPlan) * 100 : 0;
                    const cNeedle = Math.min(pct, 120);
                    const cActual = ref > 0 ? Math.min((actual / ref) * 100, 120) : 0;
                    const cPlan = ref > 0 ? Math.min((displayPlan / ref) * 100, 120) : 0;

                    if (chartInstance) chartInstance.destroy();

                    const canvas = document.getElementById(canvasId);
                    const wrapper = canvas.closest('.chart-container');
                    const w = wrapper ? wrapper.offsetWidth : 260;
                    const h = wrapper ? wrapper.offsetHeight : 260;

                    if (w < 10 || h < 10) return null;

                    canvas.width = w; canvas.height = h;
                    const ctx = canvas.getContext('2d');

                    // ── Gauge mengisi penuh area canvas ──
                    // Gunakan dimensi terkecil dengan margin tipis (6%) agar arc tidak terpotong
                    const safe = Math.min(w, h) * 0.94;
                    const rO = safe * 0.42;    // radius outer
                    const rM = safe * 0.33;    // radius middle
                    const rI = safe * 0.24;    // radius inner
                    const lw = safe * 0.046;   // line width arc
                    const sc = safe / 190;     // scale umum untuk tick/needle/font

                    // Posisi center: gauge arc 135°–45° membutuhkan lebih banyak ruang di bawah
                    // centerY di 50% agar gauge benar-benar center dan tidak ada ruang kosong
                    const cx = w * 0.58;
                    const cy = h * 0.50;

                    ctx.clearRect(0, 0, w, h);

                    // Backlight
                    let bc, bi;
                    if (pct < 80) { bc = 'rgba(217,4,41,'; bi = 0.5; }
                    else if (pct < 85) { bc = 'rgba(255,193,7,'; bi = 0.4; }
                    else { bc = 'rgba(40,167,69,'; bi = 0.35; }
                    const blR = Math.max(rO * 0.28, 10);
                    const sa = Math.PI * 0.75, ea = Math.PI * 2.25;
                    const gl = ctx.createRadialGradient(cx, cy, blR - 12, cx, cy, blR + 12);
                    gl.addColorStop(0, bc + '0)'); gl.addColorStop(0.5, bc + bi + ')'); gl.addColorStop(1, bc + '0)');
                    ctx.beginPath(); ctx.arc(cx, cy, blR, sa, ea, false); ctx.strokeStyle = gl; ctx.lineWidth = 22 * sc; ctx.stroke();

                    // Arcs
                    drawSolidArc(ctx, cx, cy, rO, 100, '#F59E0B', lw * 1.5);
                    drawSolidArc(ctx, cx, cy, rM, cPlan, '#22C55E', lw * 1.5);
                    drawSolidArc(ctx, cx, cy, rI, cActual, '#A855F7', lw * 1.5);

                    // Tick marks
                    for (let i = 0; i < 11; i++) {
                        const a = sa + (ea - sa) * (i / 10), maj = i % 2 === 0;
                        const rIn = rO - 43 * sc, rOut = rO - (maj ? 39 : 41) * sc;
                        ctx.beginPath(); ctx.moveTo(cx + rIn * Math.cos(a), cy + rIn * Math.sin(a)); ctx.lineTo(cx + rOut * Math.cos(a), cy + rOut * Math.sin(a));
                        ctx.strokeStyle = isLightMode ? 'rgba(20,20,40,0.9)' : 'rgba(255,255,255,0.9)'; ctx.lineWidth = maj ? 2 * sc : 1.5 * sc; ctx.stroke();
                    }

                    // Numbers
                    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                    [0, 20, 40, 60, 80, 100, 120].forEach(n => {
                        const a = sa + (ea - sa) * (n / 120), tr = rO - 52 * sc;
                        const x = cx + tr * Math.cos(a), y = cy + tr * Math.sin(a);
                        const gn = ctx.createRadialGradient(x, y, 0, x, y, 15 * sc);
                        gn.addColorStop(0, 'rgba(100,150,255,0.4)'); gn.addColorStop(0.5, 'rgba(100,150,255,0.2)'); gn.addColorStop(1, 'rgba(100,150,255,0)');
                        ctx.fillStyle = gn; ctx.fillRect(x - 15 * sc, y - 15 * sc, 30 * sc, 30 * sc);
                        ctx.fillStyle = isLightMode ? 'rgba(10,10,30,1)' : 'rgba(255,255,255,1)'; ctx.font = `bold ${Math.max(8, Math.round(9 * sc))}px Arial`; ctx.fillText(n, x, y);
                    });

                    // Needle
                    const nl = rO * 0.52, na = sa + (ea - sa) * (Math.min(cNeedle, 120) / 120);
                    const nx = cx + nl * Math.cos(na), ny = cy + nl * Math.sin(na);
                    ctx.beginPath(); ctx.moveTo(cx + 2, cy + 2); ctx.lineTo(nx + 2, ny + 2); ctx.strokeStyle = 'rgba(0,0,0,0.4)'; ctx.lineWidth = 6 * sc; ctx.stroke();
                    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(nx, ny); ctx.strokeStyle = isLightMode ? 'rgba(10,10,30,1)' : 'rgba(255,255,255,1)'; ctx.lineWidth = 3 * sc; ctx.lineCap = 'round'; ctx.stroke();

                    // Center dot
                    ctx.beginPath(); ctx.arc(cx, cy, 10 * sc, 0, 2 * Math.PI); ctx.fillStyle = isLightMode ? '#0a0a1e' : '#ffffff'; ctx.fill();
                    ctx.strokeStyle = isLightMode ? '#b2dcd7' : '#363B5E'; ctx.lineWidth = 3 * sc; ctx.stroke();
                    ctx.beginPath(); ctx.arc(cx, cy, 4 * sc, 0, 2 * Math.PI); ctx.fillStyle = '#363B5E'; ctx.fill();

                    // Update HTML legend (posisi & ukuran diatur oleh CSS container query)
                    const lid = canvasId === 'chartCU' ? 'cu' : 'cs';
                    document.getElementById(`legend-actual-${lid}`).textContent = actual.toLocaleString('id-ID');
                    document.getElementById(`legend-plan-${lid}`).textContent = displayPlan.toLocaleString('id-ID');
                    const achPct = displayPlan > 0 ? ((actual / displayPlan) * 100).toFixed(0) : 0;
                    document.getElementById(`legend-achievement-${lid}`).textContent = achPct;
                    //document.getElementById(`total-plan-display-${lid}`).textContent = maxDaily.toLocaleString('id-ID');
                    const sd = document.getElementById(`speed-dot-${lid}`);
                    if (sd) { const c = parseFloat(achPct) >= 85 ? '#22C55E' : parseFloat(achPct) >= 80 ? '#F59E0B' : '#d90429'; sd.style.background = c; sd.style.borderColor = c; }
                    // ── Badge label (CU / CS) digambar di canvas ──
                    // Posisi: di bawah titik tengah gauge, di area "flat" bawah arc
                    const label = canvasId === 'chartCU' ? 'CU' : 'CS';
                    const badgeFontSize = Math.max(11, Math.round(sc * 16));  // ukuran font badge
                    const badgeW = badgeFontSize * 2.8;                    // lebar kotak badge
                    const badgeH = badgeFontSize * 1.6;                    // tinggi kotak badge
                    const badgeX = cx - badgeW / 2;
                    const badgeY = cy + rO * 0.60;                         // posisi vertikal (naikkan = kurangi 0.28)

                    // Kotak background badge
                    ctx.save();
                    ctx.beginPath();
                    const r = 5; // border-radius sudut kotak
                    ctx.moveTo(badgeX + r, badgeY);
                    ctx.lineTo(badgeX + badgeW - r, badgeY);
                    ctx.quadraticCurveTo(badgeX + badgeW, badgeY, badgeX + badgeW, badgeY + r);
                    ctx.lineTo(badgeX + badgeW, badgeY + badgeH - r);
                    ctx.quadraticCurveTo(badgeX + badgeW, badgeY + badgeH, badgeX + badgeW - r, badgeY + badgeH);
                    ctx.lineTo(badgeX + r, badgeY + badgeH);
                    ctx.quadraticCurveTo(badgeX, badgeY + badgeH, badgeX, badgeY + badgeH - r);
                    ctx.lineTo(badgeX, badgeY + r);
                    ctx.quadraticCurveTo(badgeX, badgeY, badgeX + r, badgeY);
                    ctx.closePath();
                    ctx.fillStyle = 'rgba(255, 255, 255, 0)';
                    ctx.fill();
                    ctx.strokeStyle = isLightMode ? 'rgba(10,10,30,0.7)' : 'rgba(255, 255, 255, 0.5)';
                    ctx.lineWidth = 1.5;
                    ctx.stroke();

                    // Teks label di dalam kotak
        ctx.fillStyle = isLightMode ? '#0a0a1e' : '#ffffff';
        ctx.font = `bold ${badgeFontSize}px "DIN Pro", Verdana, sans-serif`;
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(label, cx, badgeY + badgeH / 2);
                    ctx.restore();


                    return null;

                }

                function renderDefectBar(containerId, defectsByCategory) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const sorted = [...defectsByCategory].sort((a, b) => b.count - a.count);
            const total = sorted.reduce((sum, d) => sum + d.count, 0);  // ← total semua defect
            container.innerHTML = '';
            sorted.forEach(d => {
                const pct = total > 0 ? (d.count / total) * 100 : 0;  // ← proporsional terhadap total
                const row = document.createElement('div');
                row.className = 'defect-bar-row';
                row.innerHTML = `
                    <div class="defect-bar-label">${d.category}</div>
                    <div class="defect-bar-track">
                        <div class="defect-bar-fill" style="width:${pct}%"></div>
                    </div>
                    <span class="defect-bar-value" style="position:static; transform:none; font-size:0.85rem; min-width:35px; text-align:right;">${pct.toFixed(0)}%</span>
                `;
                container.appendChild(row);
            });
        }

        function setDate() {
            const dateElement = document.getElementById('current-date');
            const now = new Date();
            const weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            const formattedDate = `${weekdays[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            dateElement.textContent = formattedDate;
        }

        function drawLossTimeMarkers(trackId, hourlyEvents, totalMinutesInTimeline) {
            const trackElement = document.getElementById(trackId);
            if (!trackElement || !hourlyEvents) return;
            trackElement.querySelectorAll('.loss-marker').forEach(marker => marker.remove());
            if (totalMinutesInTimeline <= 0) return;
            for (const hour in hourlyEvents) {
                if (hourlyEvents.hasOwnProperty(hour)) {
                    hourlyEvents[hour].forEach(event => {
                        const startOffsetMinutes = ((parseInt(hour) - 7) * 60) + event.startMinute;
                        const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;
                        const widthPercent = (event.durationMinutes / totalMinutesInTimeline) * 100;
                        if (leftPercent + widthPercent <= 100) {
                            const marker = document.createElement('div');
                            marker.className = 'loss-marker';
                            marker.style.left = `${leftPercent}%`;
                            marker.style.width = `${widthPercent}%`;
                            trackElement.appendChild(marker);
                        }
                    });
                }
            }
        }

        function drawBreakTimeMarkers(trackId, breakTimes, totalMinutesInTimeline) {
            const trackElement = document.getElementById(trackId);
            if (!trackElement || !breakTimes) return;
            trackElement.querySelectorAll('.break-marker').forEach(marker => marker.remove());
            if (totalMinutesInTimeline <= 0) return;
            const timelineStartHour = 7;
            breakTimes.forEach(breakTime => {
                const startParts = breakTime.start.split(':').map(Number);
                const endParts = breakTime.end.split(':').map(Number);
                const startTotalMinutes = startParts[0] * 60 + startParts[1];
                const endTotalMinutes = endParts[0] * 60 + endParts[1];
                const startOffsetMinutes = startTotalMinutes - (timelineStartHour * 60);
                const durationMinutes = endTotalMinutes - startTotalMinutes;
                if (durationMinutes <= 0) return;
                const leftPercent = (startOffsetMinutes / totalMinutesInTimeline) * 100;
                const widthPercent = (durationMinutes / totalMinutesInTimeline) * 100;
                if (leftPercent + widthPercent <= 100) {
                    const marker = document.createElement('div');
                    marker.className = 'break-marker';
                    marker.style.left = `${leftPercent}%`;
                    marker.style.width = `${widthPercent}%`;
                    trackElement.appendChild(marker);
                }
            });
        }

        function updateAssemblyTimeline(lineId, lossData) {
            const trackElement = document.getElementById(`timeline-track-${lineId}`);
            const progressElement = document.getElementById(`timeline-progress-${lineId}`);
            const minutesContainer = document.getElementById(`timeline-minutes-${lineId}`);
            const hoursElement = document.querySelector(`#timeline-track-${lineId}`).closest('.timeline-container').querySelector('.timeline-hours');
            if (!trackElement || !hoursElement || !progressElement || !minutesContainer) return;
            const now = new Date();
            const startHour = 7;
            const endOfDayHour = 16;
            let displayEndHour = now.getHours() + 1;
            displayEndHour = Math.max(startHour + 1, displayEndHour);
            displayEndHour = Math.min(displayEndHour, endOfDayHour);
            const totalMinutesInTimeline = (displayEndHour - startHour) * 60;
            hoursElement.innerHTML = '';
            for (let h = startHour; h < displayEndHour; h++) {
                const hourSpan = document.createElement('span');
                hourSpan.textContent = `${String(h).padStart(2, '0')}.00`;
                hoursElement.appendChild(hourSpan);
            }
            minutesContainer.innerHTML = '';
            drawBreakTimeMarkers(`timeline-track-${lineId}`, lossData.breakTimes, totalMinutesInTimeline);
            drawLossTimeMarkers(`timeline-track-${lineId}`, lossData.hourlyEvents, totalMinutesInTimeline);
            const timelineStart = new Date(now);
            timelineStart.setHours(startHour, 0, 0, 0);
            let elapsedMillis = now - timelineStart;
            const totalDurationMillis = totalMinutesInTimeline * 60 * 1000;
            elapsedMillis = Math.max(0, Math.min(elapsedMillis, totalDurationMillis));
            const progressPercent = (totalDurationMillis > 0) ? (elapsedMillis / totalDurationMillis) * 100 : 0;
            progressElement.style.width = `${progressPercent}%`;
        }

        function getRowClass(oee, oratio, ability, quality) {
            const minVal = Math.min(parseFloat(oee) || 0, parseFloat(oratio) || 0, parseFloat(ability) || 0, parseFloat(quality) || 0);
            if (minVal < 80) return 'row-red';
            if (minVal < 85) return 'row-yellow';
            return 'row-green';
        }

